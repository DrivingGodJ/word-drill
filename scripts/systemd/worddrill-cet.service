[Unit]
Description=WordDrill approved CET vocabulary ingestion
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=worddrill
Group=worddrill
WorkingDirectory=/var/lib/worddrill/repo
ExecStart=/usr/bin/python3 /opt/worddrill/add-cet-words.py --repo /var/lib/worddrill/repo --progress-repo /var/lib/worddrill/progress.git
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=GIT_TERMINAL_PROMPT=0
Environment=TZ=Asia/Shanghai
UMask=0077
TimeoutStartSec=5min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/worddrill
